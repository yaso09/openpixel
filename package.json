{
  "name": "openpixel",
  "version": "0.1.3",
  "private": true,
  "description": "Pixel art JSON assets, a TypeScript SVG renderer, and Rust CLI/MCP tools",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace @openpixel/renderer",
    "build:www": "npm run build && node www/build.mjs",
    "pack:renderer": "npm pack --workspace @openpixel/renderer",
    "release:dry": "node scripts/semantic-release.mjs --dry-run"
  }
}
